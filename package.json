{
  "name": "dimpleslipcare",
  "private": true,
  "scripts": {
    "dev":       "pnpm --filter web dev",
    "build":     "pnpm --filter web build",
    "api:dev":   "pnpm --filter api start:dev",
    "api:build": "pnpm --filter api build",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter api typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
